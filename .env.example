# =============================================================================
# wikijs-mcp-rag — environment variables (single source of truth: src/config.ts)
#
# Copy this file to `.env` and fill in the REQUIRED values before starting.
# The values shown are the defaults from config.ts or safe placeholders.
# This file is safe to commit: it contains no real secrets.
# =============================================================================

# --- Server (MCP) -----------------------------------------------------------
# MCP server listen host and port (published on the host by Docker).
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Auth (MCP) -------------------------------------------------------------
# REQUIRED: bearer token for /mcp, /sse and /message. Change it to a secure value.
# Alternative for local development only: leave it empty + MCP_ALLOW_NOAUTH=true
# (starts WITHOUT auth with a noisy warning; NEVER expose that instance).
MCP_TOKEN=cambia-por-un-token-seguro
# false => the process does NOT start if MCP_TOKEN is empty. true => dev mode without auth.
MCP_ALLOW_NOAUTH=false

# --- Wiki.js (EXTERNAL instance, not part of the compose) --------------------
# Base URL of the Wiki.js instance (actual endpoint: <base>/graphql).
WIKIJS_BASE_URL=https://wiki.example.com
# OPTIONAL: Wiki.js admin token. Leave it empty if the instance does NOT use an API key
# (the client will omit the Authorization header and start with a warning).
WIKIJS_TOKEN=
# true => accepts the proxy's self-signed TLS certificate (required for self-signed deployments).
WIKIJS_INSECURE_TLS=true

# --- Embeddings / RAG -------------------------------------------------------
# REQUIRED: base URL of the external embeddings server (llama.cpp, OpenAI-compatible).
# The client POSTs to <base>/embeddings.
EMBEDDINGS_BASE_URL=http://localhost:8071/v1
# API key (llama.cpp ignores it, but the OpenAI-compatible client sends it).
EMBEDDINGS_API_KEY=no-key
# Model name (metadata; stored in meta). Changing model/dims => reindex.
EMBEDDINGS_MODEL=Qwen3-Embedding-0.6B
# Embedding dimensionality. 1024 for Qwen3-Embedding-0.6B; 768 for EmbeddingGemma-300M.
EMBEDDINGS_DIM=1024
# Path of the SQLite file (sqlite-vec). In Docker: inside the /data volume.
RAG_DB_PATH=/data/rag.db
# Chunking parameters (target size and overlap, in tokens).
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=150
# Default top-K of the RAG search.
RAG_DEFAULT_TOP_K=5

# --- Sync -------------------------------------------------------------------
# Incremental poller interval (ms). 300000 = 5 min. 0 => disabled.
SYNC_POLL_INTERVAL_MS=300000
# Local hour (0-23) of the full nightly reindex.
NIGHTLY_RESYNC_HOUR=3
# true => enables the nightly resync.
NIGHTLY_RESYNC_ENABLED=true

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
