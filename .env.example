# =============================================================================
# wikijs-mcp-rag — variables de entorno (fuente única: src/config.ts)
#
# Copia este archivo a `.env` y rellena los valores REQUERIDOS antes de arrancar.
# Los valores mostrados son el default de config.ts o un placeholder seguro.
# Este archivo es seguro de commitear: no contiene secrets reales.
# =============================================================================

# --- Server (MCP) -----------------------------------------------------------
# Host y puerto de escucha del servidor MCP (publicado en el host por Docker).
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Auth (MCP) -------------------------------------------------------------
# REQUERIDO: bearer token para /mcp, /sse y /message. Cámbialo por un valor seguro.
# Alternativa solo en desarrollo local: dejarlo vacío + MCP_ALLOW_NOAUTH=true
# (arranca SIN auth con un warning ruidoso; NUNCA expongas esa instancia).
MCP_TOKEN=cambia-por-un-token-seguro
# false => si MCP_TOKEN está vacío el proceso NO arranca. true => modo dev sin auth.
MCP_ALLOW_NOAUTH=false

# --- Wiki.js (instancia EXTERNA, no va en el compose) ------------------------
# URL base de la instancia de Wiki.js (endpoint real: <base>/api/graphql).
WIKIJS_BASE_URL=https://wiki.example.com
# REQUERIDO: token admin de Wiki.js. Déjalo vacío hasta que tengas el token;
# el servidor no arrancará sin él (config lo valida con min(1)).
WIKIJS_TOKEN=
# true => acepta el certificado TLS autofirmado del proxy (necesario en este despliegue).
WIKIJS_INSECURE_TLS=true

# --- Embeddings / RAG -------------------------------------------------------
# REQUERIDO: URL base del servidor de embeddings externo (llama.cpp, OpenAI-compatible).
# El cliente hace POST a <base>/embeddings.
EMBEDDINGS_BASE_URL=http://localhost:8071/v1
# API key (llama.cpp la ignora, pero el cliente OpenAI-compatible la envía).
EMBEDDINGS_API_KEY=no-key
# Nombre del modelo (metadato; se guarda en meta). Cambiar modelo/dims => reindexar.
EMBEDDINGS_MODEL=Qwen3-Embedding-0.6B
# Dimensionalidad del embedding. 1024 para Qwen3-Embedding-0.6B; 768 para EmbeddingGemma-300M.
EMBEDDINGS_DIM=1024
# Ruta del fichero SQLite (sqlite-vec). En Docker: dentro del volumen /data.
RAG_DB_PATH=/data/rag.db
# Parámetros de chunking (tamaño objetivo y solapamiento, en tokens).
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=150
# Top-K por defecto de la búsqueda RAG.
RAG_DEFAULT_TOP_K=5

# --- Sync -------------------------------------------------------------------
# Intervalo del poller incremental (ms). 300000 = 5 min. 0 => desactivado.
SYNC_POLL_INTERVAL_MS=300000
# Hora local (0-23) del reindex completo nocturno.
NIGHTLY_RESYNC_HOUR=3
# true => activa el resync nocturno.
NIGHTLY_RESYNC_ENABLED=true

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
